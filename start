#!/usr/bin/env python3
"""
Pap Signal Harvester — orchestrates connectors, normalisation and scoring.

Quick start:
1) pip install feedparser pyyaml python-dateutil
   (Optional) pip install praw psycopg[binary] for Reddit + Postgres support.
2) python start
   The first run will create pap_config.yaml — edit it with your feeds/API keys.
"""

from __future__ import annotations

import asyncio
from typing import List

from paptool.config import Config, ensure_config
from paptool.connectors import build_connectors
from paptool.output import print_console, write_csv, write_markdown
from paptool.pipeline import run_pipeline
from paptool.storage import create_storage, persist
from paptool.models import NormalisedSignal


async def harvest(cfg: Config) -> List[NormalisedSignal]:
    connectors = build_connectors(cfg)
    if not connectors:
        print("[!] No connectors configured. Update pap_config.yaml -> connectors")
        return []
    print(f"[i] Running {len(connectors)} connector(s)...")
    signals = await run_pipeline(cfg, connectors)
    return signals


def main() -> None:
    try:
        cfg = ensure_config()
    except SystemExit:
        return

    signals = asyncio.run(harvest(cfg))
    if not signals:
        print("[!] No signals harvested. Adjust your feeds or vocabulary.")
        return

    output_cfg = cfg.output or {}
    max_rows = int(output_cfg.get("max_rows", 200))
    console_limit = int(output_cfg.get("console_limit", 30))
    trimmed = signals[:max_rows]

    print_console(trimmed, limit=console_limit)

    csv_path = output_cfg.get("csv_path")
    if csv_path:
        write_csv(csv_path, trimmed)
        print(f"[i] Saved {len(trimmed)} signals to {csv_path}")

    md_path = output_cfg.get("markdown_path")
    if md_path:
        write_markdown(md_path, trimmed)
        print(f"[i] Wrote Markdown summary to {md_path}")

    storage = create_storage(cfg)
    if storage:
        persist(storage, trimmed)
        print("[i] Persisted signals to storage backend")

    print("[i] Pipeline complete.")


if __name__ == "__main__":
    main()
