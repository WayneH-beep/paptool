def ensure_config(path: str = "./pap_config.yaml") -> Dict[str, Any]:
    if not os.path.exists(path):
        with open(path, "w", encoding="utf-8") as f:
            f.write(DEFAULT_CONFIG_YAML)
        print(f"[i] Created default config at {path}. Edit it and run again.")
        sys.exit(0)
    with open(path, "r", encoding="utf-8") as f:
        return yaml.safe_load(f)


# ------------------------- Utilities -------------------------

def norm_text(*parts: str) -> str:
    txt = " ".join(p for p in parts if p)
    # collapse whitespace
    return re.sub(r"\s+", " ", txt).strip()


def to_utc(dt_str: str) -> datetime:
    try:
        dt = dateparser.parse(dt_str)
        if not dt:
            return datetime.now(timezone.utc)
        if not dt.tzinfo:
            dt = dt.replace(tzinfo=timezone.utc)
        return dt.astimezone(timezone.utc)
    except Exception:
        return datetime.now(timezone.utc)


def haversine_km(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
    R = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlmb = math.radians(lon2 - lon1)
    a = math.sin(dphi/2)**2 + math.cos(p1)*math.cos(p2)*math.sin(dlmb/2)**2
    return 2 * R * math.asin(math.sqrt(a))


def host_weight(link: str, source_weights: Dict[str, float]) -> float:
    m = re.search(r"https?://([^/]+)/?", link or "", re.I)
    if not m:
        return 0.3
    host = m.group(1).lower()
    for k, v in source_weights.items():
        if k in host:
            return float(v)
    return 0.4  # default


def sha1(text: str) -> str:
    return hashlib.sha1(text.encode("utf-8", "ignore")).hexdigest()


# ------------------------- NLP-ish bits -------------------------

def keyword_score(text: str, kw: Dict[str, float], code_names: Dict[str, float], negatives: List[str]) -> Tuple[float, List[str], bool]:
    t = text.lower()
    signals = []
    score = 0.0
    for k, w in kw.items():
        if k in t:
            signals.append(k)
            score += float(w)
    for k, w in code_names.items():
        if k in t:
            signals.append(k)
            score += float(w)
    negative_hit = any(neg in t for neg in negatives)
    if negative_hit:
        score *= 0.5  # dampen noisy items
    # Normalise roughly to 0..1 range-ish
    return min(score / 10.0, 1.0), signals, negative_hit


def detect_zone(text: str, zones: Dict[str, Dict[str, float]]) -> Tuple[str, float, float]:
    t = text.lower()
    for name, coords in zones.items():
        if name in t:
            return name, float(coords["lat"]), float(coords["lon"])
    return "", float("nan"), float("nan")


# ------------------------- Scoring -------------------------

def recency_component(published_utc: datetime, half_life_h: float) -> float:
    age_h = (datetime.now(timezone.utc) - published_utc).total_seconds() / 3600.0
    if age_h < 0:
        age_h = 0
    # exponential decay: value halves each half_life
    return max(0.0, 0.5 ** (age_h / max(half_life_h, 0.1)))


def proximity_component(item_lat: float, item_lon: float, home_lat: float, home_lon: float, max_km: float) -> float:
    if any(math.isnan(x) for x in [item_lat, item_lon]):
        return 0.0
    km = haversine_km(item_lat, item_lon, home_lat, home_lon)
    if km >= max_km:
        return 0.0
    return 1.0 - (km / max_km)


def final_score(recency, proximity, kw, src, evidence, weights) -> float:
    return (
        weights["recency"] * recency +
        weights["proximity"] * proximity +
        weights["keywords"] * kw +
        weights["source_cred"] * src +
        weights["evidence"] * evidence
    )


# ------------------------- Fetch & Normalise -------------------------

def fetch_feed(url: str) -> List[Dict[str, Any]]:
    parsed = feedparser.parse(url)
    items = []
    for e in parsed.entries:
        title = e.get("title", "")
        summary = e.get("summary", "") or e.get("description", "")
        link = e.get("link", "")
        published = e.get("published", "") or e.get("updated", "")
        published_utc = to_utc(published) if published else datetime.now(timezone.utc)
        text = norm_text(title, summary)
        items.append({
            "source_url": url,
            "title": title,
            "text": text,
            "link": link,
            "published_utc": published_utc,
        })
    return items


# ------------------------- Main -------------------------

def main():
    cfg = ensure_config()
    feeds = cfg.get("feeds", [])
    if not feeds:
        print("[!] No feeds configured. Edit pap_config.yaml -> feeds")
        return

    kw = {k.lower(): float(v) for k, v in (cfg.get("keywords") or {}).items()}
    codes = {k.lower(): float(v) for k, v in (cfg.get("code_names") or {}).items()}
    negatives = [s.lower() for s in (cfg.get("negative_keywords") or [])]
    zones = {k.lower(): v for k, v in (cfg.get("zones") or {}).items()}
    scoring_cfg = cfg.get("scoring") or {}
    half_life = float(scoring_cfg.get("recency_half_life_hours", 24))
    max_km = float(scoring_cfg.get("max_km_for_proximity", 60))
    weights = scoring_cfg.get("weights") or {"recency":0.35,"proximity":0.25,"keywords":0.25,"source_cred":0.1,"evidence":0.05}
    source_weights = cfg.get("source_weights") or {}
    out_csv = (cfg.get("output") or {}).get("csv_path", "./signals.csv")
    max_rows = int((cfg.get("output") or {}).get("max_rows", 100))

    home = cfg.get("home_base") or {}
    home_lat = float(home.get("lat", 51.5074))
    home_lon = float(home.get("lon", -0.1278))

    all_hits = []
    for url in feeds:
        try:
            for item in fetch_feed(url):
                text = item["text"]
                zone_name, zlat, zlon = detect_zone(text, zones)
                kw_component, signals, negflag = keyword_score(text, kw, codes, negatives)
                src_cred = host_weight(item["link"], source_weights)

                rec_comp = recency_component(item["published_utc"], half_life)
                prox_comp = proximity_component(zlat, zlon, home_lat, home_lon, max_km)
                evidence = 0.2 if re.search(r"(ttro|order|notice|pdf|road\s+closure|permit)", text, re.I) else 0.0

                score = final_score(rec_comp, prox_comp, kw_component, src_cred, evidence, weights)

                all_hits.append({
                    "id": sha1(f'{item["link"]}|{item["title"]}|{item["published_utc"].isoformat()}'),
                    "source": url,
                    "title": item["title"],
                    "text": text,
                    "link": item["link"],
                    "published_utc": item["published_utc"].isoformat(),
                    "zone": zone_name,
                    "signals": ", ".join(signals),
                    "negflag": negflag,
                    "recency": round(rec_comp, 3),
                    "proximity": round(prox_comp, 3),
                    "keywords": round(kw_component, 3),
                    "source_cred": round(src_cred, 3),
                    "evidence": round(evidence, 3),
                    "score": round(score, 3),
                })
        except Exception as e:
            print(f"[!] Feed error {url}: {e}")

    # De-dupe by (link+title) hash
    dedup = {}
    for h in all_hits:
        dedup[h["id"]] = max(dedup.get(h["id"], h), h, key=lambda x: x["score"])
    hits = sorted(dedup.values(), key=lambda x: x["score"], reverse=True)[:max_rows]

    # Console table
    def trunc(s, n=90): 
        return s if len(s) <= n else s[:n-1] + "…"
    print("\n=== Pap Signals (ranked) ===")
    print(f"{'Score':>5}  {'When (UTC)':<20}  {'Zone':<18}  {'Signals':<28}  Title")
    for h in hits[:30]:
        print(f"{h['score']:>5.2f}  {h['published_utc']:<20}  {h['zone'][:18]:<18}  {trunc(h['signals'],28):<28}  {trunc(h['title'], 80)}")

    # Write CSV
    fieldnames = ["score","published_utc","zone","signals","negflag","title","text","link","source","recency","proximity","keywords","source_cred","evidence","id"]
    with open(out_csv, "w", encoding="utf-8", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        for h in hits:
            w.writerow({k: h.get(k, "") for k in fieldnames})
    print(f"\n[i] Saved top {len(hits)} signals to {out_csv}")
    print("[i] Tweak weights/keywords/zones in pap_config.yaml and run again.")


if __name__ == "__main__":
    main()
